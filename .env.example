APP_ENV=development
APP_NAME=RiskPulse AI API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://riskpulse:riskpulse@localhost:5432/riskpulse
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEWS_RSS_URL=
SOCIAL_CSV_PATH=data/tweets-vs-stock.csv
REDDIT_API_BASE_URL=https://oauth.reddit.com
REDDIT_INGESTION_ENABLED=false
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=RiskPulseAI/0.1 (local development)
REDDIT_SUBREDDITS=["finance","investing"]
REDDIT_SEARCH_TERMS=[]
INGESTION_API_KEY=
INGESTION_BATCH_SIZE=25
INGESTION_POLL_INTERVAL_SECONDS=300
INGESTION_LIVE_ENABLED=false
INGESTION_LIVE_SOURCES=["news","reddit"]
INGESTION_LIVE_PROCESS_NLP=true
INGESTION_REQUEST_TIMEOUT_SECONDS=10
INGESTION_MAX_RETRIES=2
INGESTION_RETRY_BACKOFF_SECONDS=0.25
NLP_SENTIMENT_BACKEND=heuristic
NLP_SENTIMENT_MODEL_ID=ProsusAI/finbert
NLP_ALLOW_MODEL_DOWNLOAD=false
NLP_MODEL_DEVICE=cpu
NLP_MAX_TEXT_CHARS=12000
NLP_BATCH_SIZE=25
REPLAY_DEFAULT_SPEED=1
REPLAY_MAX_SPEED=10
REPLAY_DEFAULT_BATCH_SIZE=1
NLP_ENTITY_ALIASES_PATH=data/entity_aliases.json
STRESS_TRIGGER_THRESHOLD=7
STRESS_IMPACT_THRESHOLD=7
STRESS_MODEL_VERSION=stress-v1
STRESS_RECONCILIATION_TOLERANCE=0.01
RESEARCH_REPORTS_DIR=research/reports
RESEARCH_MARKET_DATA_DIR=research/market_data
